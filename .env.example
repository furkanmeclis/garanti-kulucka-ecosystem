# Garanti Kulucka Ecosystem local defaults

NODE_ENV=development

# Core infrastructure
DATABASE_URL=postgres://garanti:garanti@postgres:5432/garanti
REDIS_URL=redis://redis:6379

# Security roots; production values must be generated and stored outside git
APP_ENCRYPTION_KEY=local-dev-change-me-32-bytes-minimum
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
COOKIE_SECRET=local-dev-cookie-secret-change-me

# Garage S3-compatible storage
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=garage
S3_SECRET_ACCESS_KEY=garage
S3_BUCKET_MEDIA=garanti-media

# HTTP ports
API_PORT=3000
WEB_PORT=5173

# Admin-managed provider settings live in Postgres.
# Deployment-level provider secrets may be used only for bootstrap imports.

# Observability (P10). /metrics is off unless METRICS_ENABLED=true.
# Either set METRICS_BEARER_TOKEN (scrapes must send "Authorization: Bearer <token>")
# or set METRICS_PORT to serve /metrics on a dedicated internal-only listener.
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
METRICS_PORT=
# Worker health/readiness listener (/health/live, /health/ready, /metrics); keep it internal.
WORKER_HTTP_PORT=3001
