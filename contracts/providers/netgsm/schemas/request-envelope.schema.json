{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetGSM provider request envelope",
  "type": "object",
  "required": [
    "request_id",
    "provider",
    "operation",
    "direction",
    "channel",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "const": "netgsm"
    },
    "operation": {
      "enum": [
        "sms.send",
        "call.confirmation.create",
        "call.confirmation.status",
        "call.report",
        "voice.message.send",
        "voice.message.report"
      ]
    },
    "direction": {
      "const": "outbound"
    },
    "channel": {
      "enum": [
        "sms",
        "voice"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "legacy_contract": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
