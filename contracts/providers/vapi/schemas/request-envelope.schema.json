{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vapi provider request envelope",
  "type": "object",
  "required": ["request_id", "provider", "operation", "direction", "channel", "occurred_at", "payload"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "provider": { "const": "vapi" },
    "operation": { "enum": ["call.webhook", "call.create"] },
    "direction": { "enum": ["inbound", "outbound"] },
    "channel": { "const": "voice" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "legacy_contract": { "type": "object" }
  },
  "additionalProperties": false
}
