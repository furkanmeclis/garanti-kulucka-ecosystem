{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta provider request envelope",
  "type": "object",
  "required": ["request_id", "provider", "operation", "direction", "channel", "occurred_at", "payload"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["meta", "whatsapp", "instagram", "messenger"] },
    "operation": {
      "enum": [
        "message.webhook",
        "message.send",
        "media.publish",
        "comment.reply",
        "comment.private_reply",
        "comment.hide",
        "comment.delete"
      ]
    },
    "direction": { "enum": ["inbound", "outbound"] },
    "channel": { "enum": ["whatsapp", "instagram", "messenger"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "legacy_contract": { "type": "object" }
  },
  "additionalProperties": false
}
