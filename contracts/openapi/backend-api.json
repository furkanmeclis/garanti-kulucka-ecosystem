{
  "openapi": "3.1.0",
  "info": {
    "title": "Garanti Kulucka Backend API",
    "version": "0.1.0",
    "description": "Backend-owned HTTP contract consumed by the web app."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "API process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadyHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "API dependencies are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "refreshToken",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rotated session tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Session revoked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkStatus"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthUser"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations": {
      "get": {
        "operationId": "listConversations",
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "name": "channel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "assigned",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["unassigned"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversation_public_id}/messages": {
      "get": {
        "operationId": "listMessages",
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationPublicId"
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Conversation messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createMessage",
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationPublicId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMessageRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Message"
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{conversation_public_id}/state": {
      "patch": {
        "operationId": "updateConversationState",
        "parameters": [
          {
            "$ref": "#/components/parameters/ConversationPublicId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateConversationStateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated conversation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Conversation"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "confirmation_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Order summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{order_public_id}/status": {
      "patch": {
        "operationId": "updateOrderStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderPublicId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          }
        }
      }
    },
    "/api/shipments": {
      "get": {
        "operationId": "listShipments",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tracking_missing",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Shipment summaries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShipmentList"
                }
              }
            }
          }
        }
      }
    },
    "/api/shipments/{shipment_public_id}/status": {
      "patch": {
        "operationId": "updateShipmentStatus",
        "parameters": [
          {
            "$ref": "#/components/parameters/ShipmentPublicId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShipmentStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated shipment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shipment"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/uploads": {
      "post": {
        "operationId": "createFileUpload",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFileUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File metadata and upload instruction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUpload"
                }
              }
            }
          }
        }
      }
    },
    "/api/files/{file_public_id}": {
      "get": {
        "operationId": "getFile",
        "parameters": [
          {
            "$ref": "#/components/parameters/FilePublicId"
          }
        ],
        "responses": {
          "200": {
            "description": "File metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/webphone/config": {
      "get": {
        "operationId": "getWebphoneConfig",
        "responses": {
          "200": {
            "description": "Authorized SIP/WebRTC config",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WebphoneConfig"
                }
              }
            }
          }
        }
      }
    },
    "/admin/settings": {
      "get": {
        "operationId": "listSettings",
        "parameters": [
          {
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "global"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Admin-managed settings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingList"
                }
              }
            }
          }
        }
      }
    },
    "/admin/settings/{key}": {
      "put": {
        "operationId": "upsertSetting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertSettingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored setting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Setting"
                }
              }
            }
          }
        }
      }
    },
    "/admin/integrations/providers": {
      "get": {
        "operationId": "listIntegrationProviders",
        "responses": {
          "200": {
            "description": "Provider catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderList"
                }
              }
            }
          }
        }
      }
    },
    "/admin/integrations/accounts": {
      "get": {
        "operationId": "listIntegrationAccounts",
        "responses": {
          "200": {
            "description": "Integration accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationAccountList"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "upsertIntegrationAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertIntegrationAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored integration account",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationAccount"
                }
              }
            }
          }
        }
      }
    },
    "/admin/integrations/accounts/{account_public_id}": {
      "get": {
        "operationId": "getIntegrationAccountSnapshot",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountPublicId"
          }
        ],
        "responses": {
          "200": {
            "description": "Integration account snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationAccountSnapshot"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/admin/integrations/accounts/{account_public_id}/settings/{key}": {
      "put": {
        "operationId": "upsertIntegrationSetting",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountPublicId"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertIntegrationSettingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored integration setting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationSetting"
                }
              }
            }
          }
        }
      }
    },
    "/admin/integrations/accounts/{account_public_id}/tokens/{token_type}": {
      "put": {
        "operationId": "upsertIntegrationToken",
        "parameters": [
          {
            "$ref": "#/components/parameters/AccountPublicId"
          },
          {
            "name": "token_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertIntegrationTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored integration token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationToken"
                }
              }
            }
          }
        }
      }
    },
    "/admin/integrations/provider-attempts": {
      "get": {
        "operationId": "listProviderAttempts",
        "parameters": [
          {
            "name": "provider_key",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "account_public_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Provider attempt audit rows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAttemptList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        }
      },
      "ConversationPublicId": {
        "name": "conversation_public_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "OrderPublicId": {
        "name": "order_public_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "ShipmentPublicId": {
        "name": "shipment_public_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "FilePublicId": {
        "name": "file_public_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "AccountPublicId": {
        "name": "account_public_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "required": ["status", "service", "timestamp"],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "OkStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": {
            "type": "string",
            "minLength": 16
          }
        }
      },
      "TokenPair": {
        "type": "object",
        "required": ["access_token", "refresh_token", "token_type", "expires_in"],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer"
          }
        }
      },
      "AuthSession": {
        "allOf": [
          {
            "$ref": "#/components/schemas/TokenPair"
          },
          {
            "type": "object",
            "required": ["user"],
            "properties": {
              "user": {
                "$ref": "#/components/schemas/AuthUser"
              }
            }
          }
        ]
      },
      "AuthUser": {
        "type": "object",
        "required": ["public_id", "email", "role", "permissions"],
        "properties": {
          "public_id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "first_name": {
            "type": ["string", "null"]
          },
          "last_name": {
            "type": ["string", "null"]
          },
          "role": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sip_username": {
            "type": ["string", "null"]
          }
        }
      },
      "DataEnvelope": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array"
          }
        }
      },
      "ConversationList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "MessageList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "OrderList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "ShipmentList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "SettingList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "ProviderList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "IntegrationAccountList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "ProviderAttemptList": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DataEnvelope"
          }
        ]
      },
      "Conversation": {
        "type": "object",
        "required": ["public_id", "channel", "status", "is_in_pool", "human_agent_enabled", "unread_count", "updated_at"],
        "properties": {
          "public_id": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "is_in_pool": {
            "type": "boolean"
          },
          "human_agent_enabled": {
            "type": "boolean"
          },
          "unread_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_message_text": {
            "type": ["string", "null"]
          },
          "last_message_sender_type": {
            "type": ["string", "null"]
          },
          "last_message_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "customer": {
            "type": ["object", "null"],
            "properties": {
              "full_name": {
                "type": "string"
              },
              "phone": {
                "type": ["string", "null"]
              }
            }
          },
          "assigned_user_email": {
            "type": ["string", "null"]
          },
          "updated_at": {
